{
  "name": "sketchgit-next",
  "version": "0.11.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "dev": "NODE_ENV=development NODE_OPTIONS=--import=./lib/otelRegister.mjs tsx server.ts",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production NODE_OPTIONS=--import=./lib/otelRegister.mjs tsx server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:backfill-canvas-schema-version": "node scripts/backfill-canvas-schema-version.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "load-test:seed": "tsx load-tests/seed.ts",
    "load-test:smoke": "k6 run load-tests/smoke.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "vercel-build": "prisma generate && prisma migrate deploy && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-ioredis": "^0.59.0",
    "@opentelemetry/instrumentation-pg": "^0.61.0",
    "@opentelemetry/sdk-metrics": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fabric": "^7.4.0",
    "ioredis": "^5.11.1",
    "lru-cache": "^11.2.6",
    "mermaid": "^11.15.0",
    "next": "^16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.7",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.9.4",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.4",
    "uuid": "^14.0.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.2.7",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/fabric": "^5.3.11",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.26",
    "prisma": "^7.8.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@swc/helpers": "^0.5.19"
  }
}
